{
  "manifest_version": 3,
  "name": "Tabby — Local Tab Workspace",
  "version": "0.2.0",
  "description": "Safely save and close tabs into a private, local workspace.",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Open Tabby"
  }
}
