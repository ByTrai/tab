{
  "manifest_version": 3,
  "name": "Tabby — Local Tab Workspace",
  "version": "0.4.0",
  "description": "Safely save, organize, and restore tabs in a private, local workspace.",
  "permissions": ["tabs"],
  "optional_permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Capture with Tabby",
    "default_popup": "popup.html"
  }
}
