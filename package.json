{
  "name": "tab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/extension/packages/*"
  ],
  "scripts": {
    "build": "next build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:extension && npm run test:roadmap-issues && npm run check:manifest && npm run check:licenses",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,md,mdx,json,yml,yaml}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,md,mdx,json,yml,yaml}\" --cache",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "preview": "next build && next start",
    "start": "next start",
    "test:extension": "node --test apps/extension/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "check:manifest": "node scripts/check-extension-manifest.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "roadmap:issues": "node scripts/create-roadmap-issues.mjs",
    "test:roadmap-issues": "node --test scripts/create-roadmap-issues.test.mjs"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tabby/workspace-contracts": "*",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.22",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.22",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "overrides": {
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "brace-expansion": "^2.0.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10 <11"
  }
}
